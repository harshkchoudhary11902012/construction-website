{
  "id": "hero",
  "type": "SharedSlice",
  "name": "Hero",
  "description": "Hero section with main image and carousel",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "1",
      "description": "Hero with title, description, CTA and image carousel",
      "primary": {
        "title": {
          "type": "StructuredText",
          "config": {
            "label": "Title",
            "placeholder": "Architecture That Speaks Volumes",
            "allowTargetBlank": true,
            "single": "heading1"
          }
        },
        "description": {
          "type": "StructuredText",
          "config": {
            "label": "Description",
            "placeholder": "Modern architecture is a design approach...",
            "allowTargetBlank": true,
            "multi": "paragraph,strong,em,hyperlink"
          }
        },
        "cta_label": {
          "type": "Text",
          "config": {
            "label": "CTA Button Label",
            "placeholder": "Discover More"
          }
        },
        "cta_link": {
          "type": "Link",
          "config": {
            "label": "CTA Button Link",
            "placeholder": "/services"
          }
        },
        "carousel_images": {
          "type": "Group",
          "config": {
            "label": "Carousel Images",
            "fields": {
              "image": {
                "type": "Image",
                "config": {
                  "label": "Image",
                  "constraint": { "width": 1200, "height": 800 },
                  "thumbnails": []
                }
              }
            }
          }
        },
        "stats": {
          "type": "Group",
          "config": {
            "label": "Statistics",
            "fields": {
              "value": {
                "type": "Text",
                "config": {
                  "label": "Value",
                  "placeholder": "20+"
                }
              },
              "label": {
                "type": "Text",
                "config": {
                  "label": "Label",
                  "placeholder": "Years of Experience"
                }
              }
            }
          }
        }
      },
      "items": {}
    }
  ]
}
